# ── Server ────────────────────────────────────────────────────────────────────
# Port is provided by the host (Render/Railway inject PORT); defaults to 4000.
PORT=4000

# Comma-separated list of allowed browser origins.
# Vercel: https://your-app.vercel.app,https://your-app-git-branch.vercel.app
# Local dev: http://localhost:5173,http://localhost:4173
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# How often live "online / looking" counters are pushed to clients (ms).
PRESENCE_INTERVAL_MS=5000

# ── Admin dashboard (http://your-app/admin) ──────────────────────────────────
# Used ONCE, on the very first boot, to create the first dashboard admin:
# the account exists from then on and these two are ignored (change the
# password in the dashboard, not here). Pick at least 10 characters.
# Leave both empty to disable the dashboard entirely.
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

# ── Database — first one configured wins ──────────────────────────────────────
# Option 1 (recommended): MariaDB running on THIS machine. One-time setup:
#   sudo mariadb < scripts/mariadb-init.sql
# Then see README → "Keeping the database on this PC". Data lives in
# /var/lib/mysql — it survives reboots and grows with the app.
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_USER=matchup
MARIADB_PASSWORD=
MARIADB_DATABASE=matchup

# Option 2: MongoDB (e.g. Atlas free tier) — used only if MARIADB_DATABASE is
# unset. Leave both empty to run with the in-memory store (fine for local dev).
# Production: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/matchup
MONGODB_URI=

# ── TURN — REQUIRED FOR TRUE GLOBAL REACH ─────────────────────────────────────
# STUN (built in) discovers public IPs and covers ~85-90% of NATs. TURN relays
# the media when discovery fails: symmetric NAT, CGNAT, double NAT and
# UDP-blocking firewalls. Without it those users hit "Unable to connect".
# Full setup guide: README → "Deploying TURN".
#
# Option 1 (recommended): self-hosted coturn over the TURN REST API.
#   TURN_SECRET must equal coturn's `static-auth-secret`; credentials are
#   minted per request (HMAC-SHA1) and expire — nothing long-lived ever
#   reaches the browser.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tls
# TURN_SECRET=
# TURN_CREDENTIAL_TTL_SEC=600
#
# Option 2: Twilio Network Traversal (no TURN server to operate, usage-priced).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Option 3: any static TURN provider (Metered, Cloudflare Calls, managed coturn).
# TURN_URLS=turn:turn.example.com:3478?transport=udp
# TURN_USERNAME=matchup
# TURN_CREDENTIAL=super-secret
#
# With none of them set the server serves STUN only (Google + Twilio). ~85-90%
# of users still connect; the rest fail with "Unable to connect". Check
# `GET /health` → `ice.turnConfigured` to see which mode you are running.
