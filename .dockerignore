# Never bake local state into the image — it is built from the few paths the
# Dockerfile copies, and everything below is either huge, machine-local or a
# secret.
.git
.gitignore
.sync.log
.sync.lock
.tunnel-url
*.log

# Local env files carry live credentials (database, Docker Hub, GitHub).
# The platform injects them as environment variables instead.
.env
.env.*
**/.env
**/.env.local
**/.env.production
.deploy.env

# Build output is produced inside the image, not copied in from the host.
client/dist
client/node_modules
server/node_modules
scripts/node_modules

# Docs and the dev-only test harness are not runtime concerns.
README.md
DEPLOY.md
ADS.md
docs
scripts
